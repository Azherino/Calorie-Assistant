# ════════════════════════════════════════════════════
#  Calorie Assistant Bot — Konfigurasi Environment
# ════════════════════════════════════════════════════

# ── AI Provider Utama: Google Gemini ─────────────────
# Daftar & dapatkan API key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxx

# Model Gemini yang digunakan (default: gemini-2.0-flash)
# Pilihan lain: gemini-1.5-flash, gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.0-flash

# ── AI Provider Cadangan: Groq (gratis, sangat cepat) ─
# Aktif otomatis jika Gemini kena error 429 (quota habis)
# Daftar & dapatkan API key gratis di: https://console.groq.com
GROQ_API_KEY=gsk_xxxx

# Model Groq yang digunakan (default: llama-3.3-70b-versatile)
# Pilihan lain: llama-3.1-8b-instant (lebih cepat/hemat), mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── Konfigurasi Bot ───────────────────────────────────
# Nomor WhatsApp yang diizinkan (format: 628xxxxxxxxxx)
# Kosongkan untuk menerima pesan dari semua nomor
ALLOWED_NUMBER=

# Nama bot yang tampil ke user
BOT_NAME=Kalo

